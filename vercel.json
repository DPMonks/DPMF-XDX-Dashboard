{
  "rewrites": [
    {
      "source": "/handshake",
      "destination": "/api/handshake"
    },
    {
      "source": "/cluster/:path*",
      "destination": "/api/cluster/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
