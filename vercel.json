{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://xumm.app https://xdx-exchange.dpmf.technology; font-src 'self' data:; connect-src 'self' https://xumm.app wss://xumm.app https://api.xrpl.to https://dpmf-xdx-indexer-production.up.railway.app; frame-src https://dexscreener.com; frame-ancestors 'self' https://dpmf.technology https://*.dpmf.technology; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 20 },
    "api/overview.js": { "maxDuration": 20 },
    "api/health.js": { "maxDuration": 10 },
    "api/[...path].js": { "maxDuration": 20 },
    "api/top-holders.js": { "maxDuration": 20 },
    "api/xaman/create-payload.js": { "maxDuration": 15 },
    "api/xaman/payload-result.js": { "maxDuration": 15 },
    "api/xaman/tx-status.js": { "maxDuration": 15 },
    "api/chart/candles.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/health/xrpl", "destination": "/api/health" },
    { "source": "/handshake", "destination": "/api/index?path=handshake" },
    { "source": "/cluster/:path*", "destination": "/api/index?path=cluster/:path*" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/", "destination": "/api/index" },
    { "source": "/api/((?!xaman/|chart/).+)", "destination": "/api/index?path=$1" },
    {
      "source": "/((?!api/|favicon\\.png|apple-touch-icon\\.png|og-image\\.png|og-image\\.jpg|icons\\.svg|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
