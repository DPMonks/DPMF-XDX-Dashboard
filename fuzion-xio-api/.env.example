PORT=8080
# Xaman / Xumm Developer Console (https://apps.xumm.dev)
# Server-only. Never commit the secret or prefix it with VITE_.
# After these are set, header Connect Xaman creates a real SignIn QR.
XUMM_API_KEY=
XUMM_API_SECRET=
# Optional. Defaults to XUMM_API_SECRET for session JWTs.
# JWT_SECRET=
# Optional return URL after sign (local Vite is http://127.0.0.1:5174).
# XAMAN_RETURN_URL=http://127.0.0.1:5174
# Optional XRPL fee collector. Fees are recorded as pending until this is set.
# FEE_COLLECTOR=
